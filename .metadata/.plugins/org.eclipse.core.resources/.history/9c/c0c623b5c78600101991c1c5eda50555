@charset "UTF-8";

.login-line {
	display: flex;
	justify-content: space-between;
	font-size: 10px;
}

.login-line select {
	border: none;
	outline: none;
	font-size: 10px;
}

.login-div {
	display: flex;
	gap: 15px;
}

.head-line {
	display: flex;
	width: 100%;
	height: 70px;
	justify-content: center;
	align-items: center;
}

.logo-header {
	display: flex;
	flex: 1;
	width: 80%;
	gap: 30px;
}

.logo-div {
	width: 15%;
	text-align: center;
}

.search-line {
	display: flex;
	flex: 1;
	width: 60%;
	height: 30px;
	border: 2px solid lightskyblue;
	align-items: center;
}

.search-line div {
	height: 100%;
}

.search-menu-div {
	border-right: 1px solid lightgrey;
}
.search-menu-div > select {
	width: 70px;
	height: 100%;
	border: none;
	outline: none;
}

.search-input-div > input {
	width: 300px;
	padding-left: 5px;
	border: none;
	outline: none;
}

.emoji-div {
	display: flex;
	width: 15%;
	gap: 30px;
	justify-content: center;
	align-items: center;
}

.emoji-div > div {
	display: flex;
	flex-direction: column;
	align-items: center;
	font-size: 10px;
	
}
