        <Combo id="cb_sub_dept" taborder="5" left="457" top="176" width="295" height="35" innerdataset="ds_sub_dept" codecolumn="dept_sub__cd" datacolumn="dept_sub_nm" onitemchanged="cb_sub_dept_onitemchanged" borderRadius="5px"/>
