        <Static id="Static00_00" taborder="1" text="비밀번호 : " left="300" top="369" width="120" height="50" onclick="Static00_onclick" background="white" borderRadius="8px" textAlign="center" font="bold 17px 맑은 고딕" color="black"/>
        <Edit id="ed_id" taborder="2" left="420" top="330" width="300" height="35" onchanged="Edit00_onchanged" border="1px solid black"/>
